# Copie para .env e preencha só o que for usar. NUNCA commite o .env.
# O agente nunca imprime estes valores.

# --- Meta (subir anúncios por API) ---
# Token de System User do Business Manager com ads_management e acesso à conta, página e pixel.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=          # ex.: act_123456789
META_API_VERSION=v23.0

# --- Checkout ---
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
HOTMART_CLIENT_ID=           # opcional: leitura de vendas pela API
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=

# --- IA (opcional: só a que você usa) ---
OPENAI_API_KEY=              # não precisa se usar o Codex logado no ChatGPT
GEMINI_API_KEY=
FAL_KEY=
HIGGSFIELD_API_KEY=          # ou login do CLI/MCP da Higgsfield

# --- Outros ---
GA4_MEASUREMENT_ID=
